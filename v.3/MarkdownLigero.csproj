<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TinyMDEditor</AssemblyName>
    <RootNamespace>MarkdownLigero</RootNamespace>
    <ApplicationIcon>MarkdownLigero.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Locales\*.po" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
